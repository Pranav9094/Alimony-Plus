# Copy to .env and fill EVERY value. Never commit .env (it is git-ignored).
# Use hex values so they are safe inside URLs:   openssl rand -hex 24
POSTGRES_PASSWORD=
APP_DB_PASSWORD=
RAG_DB_PASSWORD=
REDIS_PASSWORD=
# openssl rand -hex 32
JWT_SECRET=
# exactly 64 hex characters: openssl rand -hex 32
FILE_ENCRYPTION_KEY=
# 32+ characters: openssl rand -hex 32
SERVICE_API_KEY=
