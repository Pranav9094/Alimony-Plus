# Copy to .env (never commit .env). Generate secrets with: openssl rand -hex 32
DATABASE_URL=postgres://USER:PASSWORD@127.0.0.1:5432/alimony
JWT_SECRET=
# Must be 32 bytes as 64 hex characters
FILE_ENCRYPTION_KEY=
PORT=5000
# Login attempts allowed per 15 minutes per IP (default 5; raise only for automated tests)
LOGIN_RATE_LIMIT_MAX=5
